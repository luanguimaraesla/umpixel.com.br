---
import Base from '../layouts/Base.astro';
import ProgressBar from '../components/ProgressBar.astro';
import Hero from '../components/Hero.astro';
import WealthColumn from '../components/WealthColumn.astro';
import PositionIndicator from '../components/PositionIndicator.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <ProgressBar />
  <Hero />

  <WealthColumn id="filme" endId="fim-filme">
    <Fragment slot="end">
      Fim do pedido: <strong data-dyn="requested-brl">…</strong>.<br />
      Cerca de <strong data-dyn="movie-lives">…</strong> inteiras de renda bruta no salário mínimo.
      Um filme sobre o pai dele.
    </Fragment>
  </WealthColumn>

  <Footer />
  <PositionIndicator />

  <script>
    import { boot } from '../lib/render';
    import { initReveal } from '../lib/reveal';
    import { initDebug } from '../lib/debug';
    initReveal();
    initDebug();
    boot().catch((error) => console.error('Falha ao carregar os dados:', error));
  </script>
</Base>
