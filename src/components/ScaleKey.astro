---
---

<div class="panel scale-key" aria-label="Proporção entre uma nota, um salário mínimo e um ano">
  <div class="scale-key__header">
    <p class="hero__reference"><strong>1 pixel =</strong></p>
    <img class="banknote-thumb" src="/images/nota-100-reais.png" width="288" height="134" alt="Nota de cem reais" />
  </div>
  <div class="scale-key__grid">
    <div class="scale-key__item">
      <div class="scale-key__swatch" aria-hidden="true"><span class="scale-key__pixel"></span></div>
      <p class="scale-key__value"><strong>R$ 100</strong></p>
      <p class="scale-key__caption">Uma nota</p>
    </div>
    <div class="scale-key__item">
      <div class="scale-key__swatch" aria-hidden="true"><span class="money-block" data-money-block="salary"></span></div>
      <p class="scale-key__value"><strong data-dyn="min-wage">…</strong></p>
      <p class="scale-key__caption">1 salário mínimo</p>
    </div>
    <div class="scale-key__item">
      <div class="scale-key__swatch" aria-hidden="true"><span class="money-block" data-money-block="year"></span></div>
      <p class="scale-key__value"><strong data-dyn="year-value">…</strong></p>
      <p class="scale-key__caption">1 ano</p>
    </div>
  </div>
</div>
