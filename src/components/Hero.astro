---
import ScaleKey from './ScaleKey.astro';
---

<section class="section section--black hero">
  <h1 class="hero__title">UM PIXEL</h1>
  <p class="hero__subtitle">
    Quanto representam os <strong data-dyn="requested-brl">…</strong> que Flávio Bolsonaro
    pediu a Daniel Vorcaro?
  </p>

  <div class="col-start__cta hero__cta">
    <button class="hero__start" id="btn-start" type="button" disabled>
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4.5 2.5v11L13 8z"/></svg>
      começar a descer
    </button>
    <select class="speed-select" id="speed-select-start" aria-label="Velocidade da rolagem automática" disabled>
      <option value="1" selected>1×</option>
      <option value="2">2×</option>
      <option value="3">3×</option>
    </select>
  </div>

  <ScaleKey />

  <p class="load-error" id="load-error" role="alert" hidden>
    Não foi possível carregar os dados. Verifique sua conexão e recarregue a página.
  </p>
</section>
